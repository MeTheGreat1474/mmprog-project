<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.project.controllers.VideoController"
            prefWidth="1280"
            prefHeight="800"
            stylesheets="@../styles/dashboard.css"
            style="-fx-background-color: #050505;">

    <!-- LEFT SIDEBAR -->

    <left>

        <VBox prefWidth="340"
              spacing="22"
              style="-fx-background-color: #151515;
                     -fx-padding: 25;">

            <Label text="Video Compilation"
                   style="-fx-text-fill: white;
                          -fx-font-size: 28px;
                          -fx-font-weight: bold;"/>

            <!-- IMAGE FOLDER -->

            <VBox spacing="10">

                <Label text="IMAGE FOLDER"
                       style="-fx-text-fill: #8b8b8b;
                              -fx-font-size: 11px;
                              -fx-font-weight: bold;"/>

                <HBox spacing="10">

                    <TextField fx:id="selectedFolderField"
                               editable="false"
                               promptText="Choose image folder..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #202020;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: #666;
                                      -fx-background-radius: 10;
                                      -fx-border-radius: 10;
                                      -fx-border-color: #2c2c2c;
                                      -fx-padding: 10;"/>

                    <Button text="Browse"
                            onAction="#handleChooseImageFolder"
                            style="-fx-background-color: #12b3ff;
                                   -fx-text-fill: black;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 10;
                                   -fx-cursor: hand;"/>

                </HBox>

            </VBox>

            <!-- TEXT OVERLAY -->

            <VBox spacing="10">

                <Label text="TEXT OVERLAY"
                       style="-fx-text-fill: #8b8b8b;
                              -fx-font-size: 11px;
                              -fx-font-weight: bold;"/>

                <TextArea fx:id="overlayTextArea"
                          wrapText="true"
                          prefHeight="180"
                          promptText="Enter poem, captions, or overlay text..."
                          style="-fx-control-inner-background: #202020;
                                 -fx-background-color: #202020;
                                 -fx-text-fill: #d6d6d6;
                                 -fx-prompt-text-fill: #666;
                                 -fx-highlight-fill: #12b3ff;
                                 -fx-highlight-text-fill: black;
                                 -fx-background-radius: 12;
                                 -fx-border-radius: 12;
                                 -fx-border-color: #2c2c2c;
                                 -fx-font-size: 14px;"/>

            </VBox>

            <!-- GENERATE BUTTON -->

            <Button fx:id="generateVideoButton"
                    text="Generate Video"
                    maxWidth="Infinity"
                    prefHeight="48"
                    onAction="#handleGenerateVideo"
                    style="-fx-background-color: #12b3ff;
                           -fx-text-fill: black;
                           -fx-font-size: 15px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 12;
                           -fx-cursor: hand;"/>

            <!-- LOADING -->

            <HBox alignment="CENTER">

                <ProgressIndicator fx:id="progressIndicator"
                                   visible="false"
                                   prefWidth="45"
                                   prefHeight="45"/>

            </HBox>

        </VBox>

    </left>

        <!-- CENTER VIDEO PLAYER -->

    <center>

        <StackPane style="-fx-background-color: black;">

            <!-- VIDEO -->

            <MediaView fx:id="mediaView"
                       preserveRatio="true"/>

              <!-- CONTROLS -->

              <VBox alignment="BOTTOM_CENTER"
                     StackPane.alignment="BOTTOM_CENTER"
                     pickOnBounds="false"
                     mouseTransparent="false">

                     <HBox alignment="CENTER_LEFT"
                            spacing="12"
                            maxWidth="900"
                            prefHeight="70"
                            style="-fx-background-color: rgba(20,20,20,0.82);
                                   -fx-background-radius: 14;
                                   -fx-padding: 12 18 12 18;">

                            <!-- PLAY / PAUSE -->

                            <Button fx:id="playPauseButton"
                                   text="▶"
                                   onAction="#handlePlayPause"
                                   prefWidth="42"
                                   prefHeight="42"
                                   style="-fx-background-color: #12b3ff;
                                          -fx-text-fill: black;
                                          -fx-font-weight: bold;
                                          -fx-background-radius: 8;"/>

                            <!-- SEEK BACK -->

                            <Button text="⏪"
                                   onAction="#handleSeekBackward"
                                   prefWidth="42"
                                   prefHeight="42"
                                   style="-fx-background-color: #2c2c2c;
                                          -fx-text-fill: white;
                                          -fx-background-radius: 8;"/>

                            <!-- STOP -->

                            <Button text="■"
                                   onAction="#handleStop"
                                   prefWidth="42"
                                   prefHeight="42"
                                   style="-fx-background-color: #2c2c2c;
                                          -fx-text-fill: white;
                                          -fx-background-radius: 8;"/>

                            <!-- SEEK FORWARD -->

                            <Button text="⏩"
                                   onAction="#handleSeekForward"
                                   prefWidth="42"
                                   prefHeight="42"
                                   style="-fx-background-color: #2c2c2c;
                                          -fx-text-fill: white;
                                          -fx-background-radius: 8;"/>

                            <!-- CURRENT TIME -->

                            <Label fx:id="currentTimeLabel"
                                   text="00:00"
                                   style="-fx-text-fill: white;"/>

                            <!-- SEEK BAR -->

                            <Slider fx:id="seekSlider"
                                   HBox.hgrow="ALWAYS"/>

                            <!-- TOTAL TIME -->

                            <Label fx:id="totalTimeLabel"
                                   text="00:00"
                                   style="-fx-text-fill: white;"/>

                     </HBox>

              </VBox>

        </StackPane>

    </center>

</BorderPane>