<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.project.controllers.DashboardController"
            styleClass="main-layout">
    
    <!-- ======================================================= -->
    <!-- LEFT SIDEBAR NAVIGATION PANEL                           -->
    <!-- ======================================================= -->
    <left>
        <VBox styleClass="sidebar" prefWidth="220">
            <padding>
                <Insets top="30" right="20" bottom="30" left="20"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox.margin>
                    <Insets bottom="50"/>
                </VBox.margin>
                <ImageView fitHeight="48" fitWidth="48" preserveRatio="true">
                    <image>
                        <Image url="@../images/app_icon.png"/>
                    </image>
                </ImageView>
                <Label text="Atelier" styleClass="logo-text"/>
            </HBox>
            
            <!-- Primary Navigation Links -->
            <VBox spacing="8">
                <Button text="REPOSITORY" styleClass="nav-button, nav-button-active" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
                <Button text="PROCESSING" styleClass="nav-button" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
                <Button text="MOSAIC" styleClass="nav-button" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
                <Button text="VIDEO" styleClass="nav-button" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
                <Button text="SOCIAL" styleClass="nav-button" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
            </VBox>
            
            <Region VBox.vgrow="ALWAYS" /> <!-- Auto expansion spacer pushing elements to bottom -->
            
            <!-- Secondary Navigation Links -->
            <VBox spacing="8">
                <Button text="STORAGE" styleClass="nav-button-secondary" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
                <Button text="TRASH" styleClass="nav-button-secondary" alignment="BASELINE_LEFT" maxWidth="Infinity"/>
            </VBox>
        </VBox>
    </left>
    
    <!-- ======================================================= -->
    <!-- CENTER MAIN WORKSPACE                                   -->
    <!-- ======================================================= -->
    <center>
        <BorderPane>
            
            <!-- TOP NAVIGATION / ACTION BAR -->
            <top>
                <HBox styleClass="top-bar" alignment="CENTER_LEFT" fx:id="topBar">
                    <padding>
                        <Insets top="12" right="20" bottom="12" left="20"/>
                    </padding>
                    
                    <!-- Search Bar Container (Dynamic width = Library Width) -->
                    <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
                        <TextField promptText="Search repository..." styleClass="search-field" prefWidth="400"/>
                    </HBox>
                    
                    <!-- Top Right Actions Container (Dynamically bound) -->
                    <HBox alignment="CENTER_RIGHT" spacing="15" fx:id="topRightActions" minWidth="0">
                        <Label text="⚙" styleClass="icon-label"/>
                        <Button fx:id="generateVideoBtn" text="Generate Video" styleClass="btn-primary"/>
                    </HBox>
                </HBox>
            </top>
            
            <center>
                <BorderPane styleClass="main-split" fx:id="mainSplitContainer">
                    
                    <!-- ======================================================= -->
                    <!-- CENTRAL GRID LIBRARY VIEW                               -->
                    <!-- ======================================================= -->
                    <center>
                        <BorderPane styleClass="grid-container">
                            <padding>
                                <Insets top="20" right="30" bottom="30" left="30"/>
                            </padding>
                            
                            <!-- Library Header Controls -->
                            <top>
                                <VBox spacing="5">
                                    <BorderPane.margin>
                                        <Insets bottom="40"/>
                                    </BorderPane.margin>
                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Raw Captures" styleClass="headline-text"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label fx:id="imageCountLabel" text="Showing 0 items from recent import" styleClass="subtitle-text"/>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <MenuButton fx:id="filterBtn" text="≡ Filter" styleClass="btn-filter">
                                            <items>
                                                <CustomMenuItem hideOnClick="false">
                                                    <content>
                                                        <CheckBox fx:id="filterHasAnnotation" text="Has Annotation" styleClass="menu-checkbox"/>
                                                    </content>
                                                </CustomMenuItem>
                                                <SeparatorMenuItem />
                                                <CustomMenuItem hideOnClick="false">
                                                    <content>
                                                        <CheckBox fx:id="filterTypePNG" text="PNG Images" styleClass="menu-checkbox"/>
                                                    </content>
                                                </CustomMenuItem>
                                                <CustomMenuItem hideOnClick="false">
                                                    <content>
                                                        <CheckBox fx:id="filterTypeJPEG" text="JPEG Images" styleClass="menu-checkbox"/>
                                                    </content>
                                                </CustomMenuItem>
                                                <CustomMenuItem hideOnClick="false">
                                                    <content>
                                                        <CheckBox fx:id="filterTypeRAW" text="RAW (NEF) Images" styleClass="menu-checkbox"/>
                                                    </content>
                                                </CustomMenuItem>
                                            </items>
                                        </MenuButton>
                                        <SplitMenuButton fx:id="sortBtn" text="Date Created ↑" styleClass="btn-filter">
                                            <items>
                                                <MenuItem fx:id="menuSortCreated" text="Date Created"/>
                                                <MenuItem fx:id="menuSortModified" text="Date Modified"/>
                                            </items>
                                        </SplitMenuButton>
                                    </HBox>
                                </VBox>
                            </top>
                            
                            <!-- Scrollable Image Grid Viewport -->
                            <center>
                                <ScrollPane fx:id="gridScrollPane" fitToWidth="true" styleClass="grid-scroll" hbarPolicy="NEVER">
                                    <content>
                                        <GridPane fx:id="imageGrid" hgap="20" vgap="20" alignment="TOP_LEFT">
                                            <padding>
                                                <Insets right="20" bottom="20"/>
                                            </padding>
                                        </GridPane>
                                    </content>
                                </ScrollPane>
                            </center>
                        </BorderPane>
                    </center>
                    
                    <!-- ======================================================= -->
                    <!-- RIGHT METADATA PROPERTIES PANEL                         -->
                    <!-- ======================================================= -->
                    <right>
                        <ScrollPane fitToWidth="true" styleClass="properties-panel-scroll" fx:id="metadataSidebar" hbarPolicy="NEVER" minWidth="0">
                            <VBox styleClass="properties-panel" spacing="25">
                                <padding>
                                    <Insets top="20" right="20" bottom="30" left="20"/>
                                </padding>
                                
                                <!-- Large Image Preview Pane -->
                                <VBox alignment="CENTER">
                                    <ImageView fx:id="selectedImagePreview" fitWidth="300" preserveRatio="true" styleClass="preview-image"/>
                                </VBox>
                                
                                <!-- FILE DETAILS SECTION -->
                                <VBox spacing="10">
                                    <Label text="FILE DETAILS" styleClass="section-label-blue"/>
                                    <GridPane hgap="10" vgap="8">
                                        <Label text="Name" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="prop-label"/>
                                        <TextField fx:id="metaName" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="prop-value, editable-name-field" alignment="CENTER_RIGHT" maxWidth="140"/>
                                        
                                        <Label text="Format" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="prop-label"/>
                                        <Label fx:id="metaFormat" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="prop-value" GridPane.halignment="RIGHT"/>
                                        
                                        <Label text="Size" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="prop-label"/>
                                        <Label fx:id="metaSize" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="prop-value" GridPane.halignment="RIGHT"/>
                                        
                                        <Label text="Dimensions" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="prop-label"/>
                                        <Label fx:id="metaDimensions" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="prop-value" GridPane.halignment="RIGHT"/>

                                        <Label text="Created" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="prop-label"/>
                                        <Label fx:id="metaDateCreated" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="prop-value" GridPane.halignment="RIGHT"/>
                                        
                                        <Label text="Modified" GridPane.columnIndex="0" GridPane.rowIndex="5" styleClass="prop-label"/>
                                        <Label fx:id="metaDateModified" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5" styleClass="prop-value" GridPane.halignment="RIGHT"/>

                                        <columnConstraints>
                                            <ColumnConstraints hgrow="SOMETIMES" minWidth="10" />
                                            <ColumnConstraints hgrow="ALWAYS" minWidth="10" halignment="RIGHT"/>
                                        </columnConstraints>
                                    </GridPane>
                                </VBox>
                                
                                <!-- CAMERA DATA MOCKUP SECTION -->
                                <VBox spacing="10">
                                    <Label text="CAMERA DATA" styleClass="section-label-blue"/>
                                    <GridPane styleClass="data-grid" hgap="10" vgap="10">
                                        <!-- row 0 -->
                                        <VBox styleClass="data-cell" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                            <Label text="ISO" styleClass="data-label"/>
                                            <Label fx:id="metaIso" text="-" styleClass="data-value"/>
                                        </VBox>
                                        <VBox styleClass="data-cell" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                            <Label text="APERTURE" styleClass="data-label"/>
                                            <Label fx:id="metaAperture" text="-" styleClass="data-value"/>
                                        </VBox>
                                        <!-- row 1 -->
                                        <VBox styleClass="data-cell" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                            <Label text="SHUTTER" styleClass="data-label"/>
                                            <Label fx:id="metaShutter" text="-" styleClass="data-value"/>
                                        </VBox>
                                        <VBox styleClass="data-cell" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <Label text="FOCAL LENGTH" styleClass="data-label"/>
                                            <Label fx:id="metaFocalLength" text="-" styleClass="data-value"/>
                                        </VBox>
                                        <!-- row 2 full width -->
                                        <HBox styleClass="data-cell" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2">
                                            <Label text="LENS" styleClass="data-label"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="metaLens" text="-" styleClass="data-value"/>
                                        </HBox>
                                        
                                        <columnConstraints>
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50" minWidth="10" />
                                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50" minWidth="10" />
                                        </columnConstraints>
                                    </GridPane>
                                </VBox>
                                
                                <!-- ANNOTATIONS -->
                                <VBox spacing="10">
                                    <HBox>
                                        <Label text="♥ ANNOTATIONS" styleClass="section-label-tertiary"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                    <TextArea fx:id="annotationArea" promptText="Add editorial notes, client feedback, or processing intent here..." 
                                              styleClass="annotation-area" wrapText="true" prefRowCount="4"/>
                                              
                                    <HBox spacing="10" alignment="CENTER_RIGHT">
                                        <Button fx:id="deleteImageBtn" text="Delete Image" styleClass="btn-danger-outline"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Button fx:id="removeMetadataBtn" text="Clear" styleClass="btn-secondary"/>
                                        <Button fx:id="syncMetadataBtn" text="Save Annotations" styleClass="btn-tertiary-outline"/>
                                    </HBox>
                                    <Button fx:id="openFullscreenBtn" text="Open Full Image Viewer" styleClass="btn-primary" maxWidth="Infinity">
                                        <VBox.margin>
                                            <Insets top="15"/>
                                        </VBox.margin>
                                    </Button>
                                    <Button fx:id="openEditorBtn" text="Open Image Editor" styleClass="btn-primary-outline" maxWidth="Infinity">
                                        <VBox.margin>
                                            <Insets top="10"/>
                                        </VBox.margin>
                                    </Button>
                                    <Button fx:id="openMosaicBtn" text="Open Mosaic Processor" styleClass="btn-primary-outline" maxWidth="Infinity">
                                        <VBox.margin>
                                            <Insets top="10"/>
                                        </VBox.margin>
                                    </Button>
                                </VBox>
                                
                            </VBox>
                        </ScrollPane>
                    </right>
                </BorderPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
